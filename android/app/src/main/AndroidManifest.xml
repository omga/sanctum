<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required by just_audio. Our synthesised tones are delivered via a
         StreamAudioSource, which just_audio serves over a local HTTP
         proxy on 127.0.0.1 — and on Android any socket, loopback
         included, needs INTERNET.

         This must live in the MAIN manifest, not only the debug one. The
         Flutter template puts INTERNET in src/debug for hot reload, which
         means audio appears to work throughout development and then
         breaks in release. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The palm scan's viewfinder. Requested at runtime by the camera
         plugin the first time a scan is opened; nothing else in the app
         touches it. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- camera_android_camerax declares RECORD_AUDIO and
         WRITE_EXTERNAL_STORAGE in its own manifest, and the merger folds
         them into ours.

         RECORD_AUDIO is removed. It would put "Microphone" on the Play
         listing of an app that never opens one — for a product whose
         whole claim is that nothing leaves the device, the single worst
         permission to be seen asking for — and the controller is built
         with `enableAudio: false`, so the plugin never uses it.

         WRITE_EXTERNAL_STORAGE is kept, and its cap raised from the
         plugin's 28 to 29. It was removed once as dead weight; it stopped
         being dead weight when the reveal gained a Save button. `gal`
         writes to the photo library through MediaStore, which needs no
         permission from Android 11, but on Android 10 and below it does —
         and this app's minSdk is 24. Capped at 29, it is never requested
         on anything newer.

         READ_EXTERNAL_STORAGE is not declared by anybody. The merger
         *implies* it from camerax's WRITE request, and the implication
         fires off the plugin's own declaration rather than off the merged
         result — so it appears whatever we do with WRITE. Saving needs no
         read access, so it is removed.

         All of this is invisible until somebody reads a store listing,
         so `android_manifest_test.dart` asserts each line of it. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!-- Google Play Billing, via RevenueCat. Play Billing's own
         manifest merges this in too, but declaring it here keeps the
         app's permission surface readable in one file rather than
         only in the merged output. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- The daily reading. Runtime-requested on Android 13+, and asked
         for at the payoff screen rather than on launch, so the prompt
         follows the promise instead of preceding it.

         SCHEDULE_EXACT_ALARM is deliberately NOT declared. The
         reminders schedule inexactly, which needs no Play Console
         policy declaration — a reading arriving at 08:07 rather than
         08:00 is indistinguishable to the user. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required by flutter_local_notifications to reschedule the queue
         after a reboot. Without it a device that restarts loses every
         pending reading until the app is next opened. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- PostHog is configured from Dart (see analytics_service.dart),
         not from meta-data here. One place for the project token, and
         `debug` can follow kDebugMode instead of being a hardcoded
         literal that ships true to production. Without this flag the
         plugin auto-inits on attach, finds no token, and logs an
         error on every launch. -->

    <!-- Lets ExoPlayer hold a partial wake lock so a session keeps
         playing with the screen off. Without it playback stalls when the
         device dozes, which for a sleep-adjacent app is the main use. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Background playback. A meditation is started and then put down,
         so audio must survive the screen locking. On Android that means
         a foreground service, and from SDK 34 the media-playback type
         must be declared explicitly. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:label="Sanctum"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">

        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications' alarm receivers.
             **Without these, scheduled notifications never appear, and
             nothing anywhere reports a failure.** `zonedSchedule` sets
             an AlarmManager alarm whose PendingIntent targets
             ScheduledNotificationReceiver; if that receiver is not
             declared, the alarm fires, the broadcast resolves to no
             component, and the notification is simply never posted. The
             scheduling call itself succeeds, so no Result fails, no log
             line appears, and the only symptom is silence.

             This is easy to miss because the plugin used to declare
             them itself. Since version 16 its own manifest carries only
             POST_NOTIFICATIONS and VIBRATE, and every app is expected
             to declare the rest — so an upgrade past 16 breaks
             notifications in a way that looks like a device problem.
             See the plugin README, "AndroidManifest.xml setup".

             ActionBroadcastReceiver is deliberately absent: it is only
             needed for notification actions, and these notifications
             have none. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- audio_service's playback service. Its absence is what
             produced the "Unable to start service ... AudioService: not
             found" warning in logcat: the plugin was present and trying
             to bind to a component nothing had declared. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Headset buttons and other hardware media keys. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
